#!/bin/zsh
set -euo pipefail

export PATH="${PATH:-}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# Capability labels derived from the hardware, so adding a machine does not mean
# hand-writing what it is. This only prints a suggestion; nothing is applied.
# Prints two config lines. RUNNER_LABELS holds what never changes about the Mac
# and stays on it while Off; BURST_LABELS holds what workflows select on and is
# withdrawn on Drain. The OS label uses GitHub's hosted image names — macos-26 on
# Apple silicon, macos-26-intel on Intel — so a workflow can name the same class
# whether it lands on this Mac or on a GitHub-hosted runner.
detect_capability_labels() {
  local arch chip model_name model os_major os_suffix="" ram_gb
  local -a labels
  case "$(uname -m)" in
    arm64) arch=ARM64 ;;
    x86_64) arch=X64; os_suffix=-intel ;;
    *) arch="$(uname -m)" ;;
  esac
  labels=()

  chip="$(sysctl -n machdep.cpu.brand_string 2>/dev/null || true)"
  if [[ "$chip" == Apple\ * ]]; then
    chip="${chip#Apple }"
    labels+=("${chip// /-}")
  fi

  model_name="$(system_profiler SPHardwareDataType 2>/dev/null | awk -F': ' '/Model Name/ { print $2; exit }' || true)"
  case "$model_name" in
    "MacBook Air") model=macbook_air ;;
    "MacBook Pro") model=macbook_pro ;;
    "MacBook") model=macbook ;;
    "Mac mini") model=mini ;;
    "Mac Studio") model=studio ;;
    "Mac Pro") model=mac_pro ;;
    iMac*) model=imac ;;
    *) model="" ;;
  esac
  if [[ -n "$model" ]]; then labels+=("$model"); fi

  os_major="$(sw_vers -productVersion 2>/dev/null | cut -d. -f1 || true)"
  if [[ -n "$os_major" ]]; then labels+=("macos-$os_major$os_suffix"); fi

  ram_gb=$(( $(sysctl -n hw.memsize 2>/dev/null || print 0) / 1073741824 ))
  if (( ram_gb > 0 )); then labels+=("ram-${ram_gb}gb"); fi

  print -r -- "RUNNER_LABELS=self-hosted,macOS,$arch"
  print -r -- "BURST_LABELS=${(j:,:)labels}"
}

# Answered before the configuration is read: this is what you consult while
# deciding what BURST_LABELS should say for a machine you are adding.
if [[ "${1:-}" == capabilities ]]; then
  detect_capability_labels
  exit 0
fi

APP_SUPPORT="${MAC_CI_BURST_HOME:-$HOME/Library/Application Support/MacCIBurst}"
CONFIG_FILE="${MAC_CI_BURST_CONFIG:-$APP_SUPPORT/config.env}"
STATE_FILE="${MAC_CI_BURST_STATE:-$APP_SUPPORT/desired-state}"
CAFFEINATE_LABEL="dev.mac-ci-burst.caffeinate"
CAFFEINATE_PLIST="$HOME/Library/LaunchAgents/$CAFFEINATE_LABEL.plist"
DISK_GUARD="${MAC_CI_BURST_GUARD:-$APP_SUPPORT/bin/pre-job-disk-guard.sh}"
SWEEP_STAMP="$APP_SUPPORT/last-sweep"

[[ -f "$CONFIG_FILE" ]] || { print -u2 "Missing configuration: $CONFIG_FILE"; exit 78; }
source "$CONFIG_FILE"

: "${GITHUB_SCOPE_TYPE:?GITHUB_SCOPE_TYPE must be org or repo}"
: "${GITHUB_OWNER:?GITHUB_OWNER is required}"
: "${RUNNER_NAME:?RUNNER_NAME is required}"
# Capability labels this Mac advertises only while it is Available. BURST_LABELS
# is the current form; BURST_LABEL stays accepted for single-label configs.
: "${BURST_LABEL:=}"
: "${BURST_LABELS:=$BURST_LABEL}"
BURST_LABELS="${BURST_LABELS// /}"
[[ -n "$BURST_LABELS" ]] || { print -u2 "BURST_LABELS (or BURST_LABEL) is required"; exit 78; }
: "${RUNNER_DIR:?RUNNER_DIR is required}"
: "${MIN_FREE_GIB:=100}"
: "${SOFT_FREE_GIB:=$(( MIN_FREE_GIB * 2 ))}"
: "${SWEEP_INTERVAL_SECONDS:=3600}"
: "${DISK_VOLUME:=/System/Volumes/Data}"
: "${CACHE_DIRS:=}"
: "${ARTIFACT_DIR:=}"
: "${ARTIFACT_KEEP:=3}"
: "${SWEEP_CMD:=}"
: "${SWEEP_DAYS:=3}"
: "${CLEAN_CMD:=}"
: "${CLEAN_RM:=0}"
: "${RUNNER_LABELS:=}"
: "${MONITORED_REPOSITORIES:=}"
: "${USE_CAFFEINATE:=1}"

[[ "$GITHUB_SCOPE_TYPE" == org || "$GITHUB_SCOPE_TYPE" == repo ]] || {
  print -u2 "GITHUB_SCOPE_TYPE must be org or repo"; exit 78;
}
if [[ "$GITHUB_SCOPE_TYPE" == repo ]]; then
  : "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required for repo scope}"
fi
typeset -ga burst_label_list
burst_label_list=(${(s:,:)BURST_LABELS})
for _label in "${burst_label_list[@]}"; do
  if [[ -z "$_label" || "$_label" == *[^A-Za-z0-9_.-]* ]]; then
    print -u2 "BURST_LABELS entries may contain only letters, numbers, dots, underscores, and hyphens"
    exit 78
  fi
done
unset _label

# Labels the runner keeps while Off: everything in RUNNER_LABELS that is not a
# capability. Anything else on the runner — a renamed capability, a label added
# by hand in the GitHub UI — is unmanaged and would silently keep the Mac
# matchable, so withdrawal is defined as "reduce to exactly this set".
typeset -ga static_label_list
static_label_list=()
RUNNER_LABELS="${RUNNER_LABELS// /}"
for _label in ${(s:,:)RUNNER_LABELS}; do
  [[ ",$BURST_LABELS," == *",$_label,"* ]] || static_label_list+=("$_label")
done
unset _label

mkdir -p "$APP_SUPPORT"

require_tools() {
  local tool
  for tool in gh jq; do
    command -v "$tool" >/dev/null || { print -u2 "Required tool is missing: $tool"; exit 69; }
  done
}

scope_api() {
  if [[ "$GITHUB_SCOPE_TYPE" == org ]]; then
    print -n -- "/orgs/$GITHUB_OWNER"
  else
    print -n -- "/repos/$GITHUB_OWNER/$GITHUB_REPOSITORY"
  fi
}

settings_url() {
  if [[ "$GITHUB_SCOPE_TYPE" == org ]]; then
    print -n -- "https://github.com/organizations/$GITHUB_OWNER/settings/actions/runners"
  else
    print -n -- "https://github.com/$GITHUB_OWNER/$GITHUB_REPOSITORY/settings/actions/runners"
  fi
}

desired_state() {
  [[ -f "$STATE_FILE" ]] && tr -d '\r\n' < "$STATE_FILE" || print -n off
}

set_desired_state() {
  local value="$1" temporary="$STATE_FILE.tmp.$$"
  print -r -- "$value" > "$temporary"
  mv "$temporary" "$STATE_FILE"
}

runner_json() {
  gh api --paginate "$(scope_api)/actions/runners" \
    | jq -cs --arg name "$RUNNER_NAME" '[.[].runners[]] | map(select(.name == $name)) | first // null'
}

runner_id() { runner_json | jq -r '.id // empty'; }

burst_labels_json() { jq -nc --arg csv "$BURST_LABELS" '$csv | split(",")'; }

# Schedulable means every configured capability label is present. A partial set
# still lets a job match, so it must never read as fully advertised.
has_burst_labels() {
  local json="${1:-$(runner_json)}"
  jq -e --argjson want "$(burst_labels_json)" \
    '[.labels // [] | .[].name] as $have | $want | all(. as $l | $have | index($l) != null)' \
    <<<"$json" >/dev/null
}

# Advertised, but in neither the capability set nor the static remainder: a
# renamed capability, or a label added by hand in the GitHub UI.
unmanaged_labels() {
  local json="${1:-$(runner_json)}"
  (( ${#static_label_list} )) || return 0
  jq -r --argjson known "$(jq -nc --arg csv "$BURST_LABELS,$RUNNER_LABELS" '$csv | split(",")')" \
    '[.labels // [] | .[].name] | .[] | select(. as $l | $known | index($l) == null)' <<<"$json"
}

add_burst_labels() {
  local id="$1"
  jq -nc --argjson labels "$(burst_labels_json)" '{labels: $labels}' \
    | gh api --method POST "$(scope_api)/actions/runners/$id/labels" --input - >/dev/null
}

# Withdrawal reduces the runner to its static set rather than removing only the
# labels currently configured. That also clears strays, which a BURST_LABELS-only
# removal would leave advertised forever. Without RUNNER_LABELS in the config
# there is no static set to reduce to, so fall back to the capability list.
withdrawable_labels() {
  local present
  present="$(runner_json | jq -c '[.labels // [] | .[].name]')"
  if (( ${#static_label_list} )); then
    jq -r --argjson keep "$(printf '%s\n' "${static_label_list[@]}" | jq -Rc . | jq -sc .)" \
      '.[] | select(. as $l | $keep | index($l) == null)' <<<"$present"
  else
    jq -r --argjson drop "$(burst_labels_json)" \
      '.[] | select(. as $l | $drop | index($l) != null)' <<<"$present"
  fi
}

withdraw_labels() {
  local id="$1" label
  while IFS= read -r label; do
    [[ -n "$label" ]] || continue
    # A label that will not delete (GitHub read-only labels cannot be) leaves the
    # Mac eligible. That has to be loud rather than swallowed.
    gh api --method DELETE "$(scope_api)/actions/runners/$id/labels/$label" >/dev/null \
      || print -u2 "WARNING: could not remove label '$label'; runner may still be schedulable"
  done < <(withdrawable_labels)
}

# The Available counterpart of withdraw_labels: make the advertised set match the
# configuration. Without this, a capability added or renamed while the machine is
# up stays wrong until someone re-runs `available`, and the runner advertises a
# set nobody chose.
converge_labels() {
  local id="$1" json="${2:-}" label
  [[ -n "$json" ]] || json="$(runner_json)"
  while IFS= read -r label; do
    [[ -n "$label" ]] || continue
    gh api --method DELETE "$(scope_api)/actions/runners/$id/labels/$label" >/dev/null \
      || print -u2 "WARNING: could not remove unmanaged label '$label'"
  done < <(unmanaged_labels "$json")
  has_burst_labels "$json" || add_burst_labels "$id"
}

service_label() {
  local value
  [[ -f "$RUNNER_DIR/.service" ]] || return 0
  value="$(tr -d '\r\n' < "$RUNNER_DIR/.service")"
  [[ "$value" == *.plist ]] && value="${value:t:r}"
  print -n -- "$value"
}

service_loaded() {
  local label="$(service_label)"
  [[ -n "$label" ]] || return 1
  launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1
}

start_service() {
  [[ -x "$RUNNER_DIR/svc.sh" ]] || { print -u2 "Runner service is not installed in $RUNNER_DIR"; exit 78; }
  service_loaded || (cd "$RUNNER_DIR" && ./svc.sh start >/dev/null)
}

stop_service() {
  [[ -x "$RUNNER_DIR/svc.sh" ]] || return 0
  service_loaded && (cd "$RUNNER_DIR" && ./svc.sh stop >/dev/null) || true
}

start_awake() {
  [[ "$USE_CAFFEINATE" == 1 && -f "$CAFFEINATE_PLIST" ]] || return 0
  launchctl print "gui/$(id -u)/$CAFFEINATE_LABEL" >/dev/null 2>&1 \
    || launchctl bootstrap "gui/$(id -u)" "$CAFFEINATE_PLIST"
}

stop_awake() {
  launchctl print "gui/$(id -u)/$CAFFEINATE_LABEL" >/dev/null 2>&1 \
    && launchctl bootout "gui/$(id -u)/$CAFFEINATE_LABEL" >/dev/null 2>&1 || true
}

free_gib() {
  df -Pk "$DISK_VOLUME" | awk 'NR == 2 { printf "%d", $4 / 1024 / 1024 }'
}

# The guard owns all reclamation policy; the controller only supplies the
# runner's paths, thresholds, and command templates and picks the mode.
run_disk_guard() {
  local mode="$1" line key
  [[ -x "$DISK_GUARD" ]] || return 0
  local -a env_pairs
  env_pairs=(
    "MAC_CI_BURST_GUARD_MODE=$mode"
    "MAC_CI_BURST_MIN_FREE_GIB=$MIN_FREE_GIB"
    "MAC_CI_BURST_SOFT_FREE_GIB=$SOFT_FREE_GIB"
    "MAC_CI_BURST_DISK_VOLUME=$DISK_VOLUME"
    "MAC_CI_BURST_CACHE_DIRS=$CACHE_DIRS"
    "MAC_CI_BURST_ARTIFACT_DIR=$ARTIFACT_DIR"
    "MAC_CI_BURST_ARTIFACT_KEEP=$ARTIFACT_KEEP"
    "MAC_CI_BURST_SWEEP_CMD=$SWEEP_CMD"
    "MAC_CI_BURST_SWEEP_DAYS=$SWEEP_DAYS"
    "MAC_CI_BURST_CLEAN_CMD=$CLEAN_CMD"
    "MAC_CI_BURST_CLEAN_RM=$CLEAN_RM"
    "RUNNER_WORK=$RUNNER_DIR/_work"
    "RUNNER_TOOL_CACHE=$RUNNER_DIR/_work/_tool"
  )
  # Jobs see the PATH the runner captured in .path, which can include toolchains
  # the controller's own PATH lacks — a keg-only Homebrew rustup, for instance.
  # Without it the idle sweep and the admission retry could not find cargo, so
  # they skipped reclamation that the job hook would have performed.
  if [[ -s "$RUNNER_DIR/.path" ]]; then
    env_pairs+=("PATH=$(tr -d '\n' < "$RUNNER_DIR/.path"):$PATH")
  fi
  # The runner's own .env holds the toolchain locations the guard needs to find
  # cargo and cargo-sweep. Only those two keys are forwarded.
  if [[ -f "$RUNNER_DIR/.env" ]]; then
    while IFS= read -r line; do
      key="${line%%=*}"
      case "$key" in
        CARGO_HOME|RUSTUP_HOME) env_pairs+=("$line") ;;
      esac
    done < "$RUNNER_DIR/.env"
  fi
  env "${env_pairs[@]}" "$DISK_GUARD"
}

# Idle housekeeping runs at most once per SWEEP_INTERVAL_SECONDS.
sweep_due() {
  local now stamp
  [[ -f "$SWEEP_STAMP" ]] || return 0
  now="$(date +%s)"
  stamp="$(stat -f %m "$SWEEP_STAMP" 2>/dev/null || print -n 0)"
  (( now - stamp >= SWEEP_INTERVAL_SECONDS ))
}

repositories_to_check() {
  if [[ "$GITHUB_SCOPE_TYPE" == repo ]]; then
    print -r -- "$GITHUB_REPOSITORY"
  elif [[ -n "$MONITORED_REPOSITORIES" ]]; then
    for repository in ${(s:,:)MONITORED_REPOSITORIES}; do print -r -- "$repository"; done
  fi
}

current_job_json() {
  local busy="$1" repository run_id match
  [[ "$busy" == true ]] || { print -n null; return; }
  while IFS= read -r repository; do
    [[ -n "$repository" ]] || continue
    while IFS= read -r run_id; do
      [[ -n "$run_id" ]] || continue
      match="$(gh api "/repos/$GITHUB_OWNER/$repository/actions/runs/$run_id/jobs?per_page=100" 2>/dev/null \
        | jq -c --arg runner "$RUNNER_NAME" --arg repo "$repository" \
          '.jobs[] | select(.runner_name == $runner and .status == "in_progress") | {repo: $repo, name: .name, url: .html_url}' \
        | head -n 1 || true)"
      [[ -n "$match" ]] && { print -n -- "$match"; return; }
    done < <(gh api "/repos/$GITHUB_OWNER/$repository/actions/runs?status=in_progress&per_page=20" --jq '.workflow_runs[].id' 2>/dev/null || true)
  done < <(repositories_to_check)
  print -n null
}

status_json() {
  local json id registered=false online=false busy=false schedulable=false service=false desired free state job
  json="$(runner_json)"
  id="$(jq -r '.id // empty' <<<"$json")"
  desired="$(desired_state)"
  free="$(free_gib)"

  if [[ -n "$id" ]]; then
    registered=true
    [[ "$(jq -r '.status' <<<"$json")" == online ]] && online=true
    [[ "$(jq -r '.busy' <<<"$json")" == true ]] && busy=true
    has_burst_labels "$json" && schedulable=true
  fi
  service_loaded && service=true

  if [[ "$registered" == false ]]; then state=setup-required
  elif [[ "$desired" == drain ]]; then state=draining
  elif [[ "$busy" == true ]]; then state=busy
  elif [[ "$desired" == off ]]; then state=off
  elif (( free < MIN_FREE_GIB )); then state=disk-blocked
  elif [[ "$schedulable" == true && "$online" == true ]]; then state=available
  elif [[ "$desired" == available ]]; then state=starting
  else state=off
  fi

  # Anything advertised that is neither a capability nor part of the static set.
  local unmanaged
  unmanaged="$(unmanaged_labels "${json:-null}" | jq -Rc 'select(length > 0)' | jq -sc .)"

  job="$(current_job_json "$busy")"
  jq -nc \
    --arg state "$state" --arg desired "$desired" --arg runnerName "$RUNNER_NAME" \
    --arg settingsURL "$(settings_url)" --argjson runnerId "${id:-null}" \
    --argjson registered "$registered" --argjson online "$online" --argjson busy "$busy" \
    --argjson schedulable "$schedulable" --argjson serviceLoaded "$service" \
    --argjson freeGiB "$free" --argjson minimumFreeGiB "$MIN_FREE_GIB" \
    --argjson softFreeGiB "$SOFT_FREE_GIB" --argjson currentJob "$job" \
    --argjson burstLabels "$(burst_labels_json)" \
    --argjson advertisedLabels "$(jq -c '[.labels // [] | .[].name]' <<<"${json:-null}")" \
    --argjson unmanagedLabels "$unmanaged" \
    '{state:$state,desired:$desired,runnerName:$runnerName,runnerId:$runnerId,settingsURL:$settingsURL,
      registered:$registered,online:$online,busy:$busy,schedulable:$schedulable,
      serviceLoaded:$serviceLoaded,freeGiB:$freeGiB,minimumFreeGiB:$minimumFreeGiB,
      softFreeGiB:$softFreeGiB,currentJob:$currentJob,
      burstLabels:$burstLabels,advertisedLabels:$advertisedLabels,
      unmanagedLabels:$unmanagedLabels}'
}

make_available() {
  local json id free busy
  json="$(runner_json)"
  id="$(jq -r '.id // empty' <<<"$json")"
  busy="$(jq -r '.busy // false' <<<"$json")"
  [[ -n "$id" ]] || { print -u2 "Runner is not registered yet"; exit 78; }
  [[ "$busy" != true ]] || { print -u2 "Runner is already busy; wait or keep draining"; exit 75; }
  free="$(free_gib)"
  if (( free < MIN_FREE_GIB )); then
    # Give the tiered guard a chance to reclaim before refusing availability.
    run_disk_guard admit || true
    free="$(free_gib)"
  fi
  (( free >= MIN_FREE_GIB )) || { print -u2 "Only ${free} GiB is free; ${MIN_FREE_GIB} GiB is required"; exit 75; }
  set_desired_state available
  converge_labels "$id" "$json"
  start_awake
  start_service
}

begin_drain() {
  local id="$(runner_id)"
  [[ -n "$id" ]] || { set_desired_state off; return; }
  withdraw_labels "$id"
  set_desired_state drain
  reconcile
}

turn_off() {
  local json id busy
  json="$(runner_json)"
  id="$(jq -r '.id // empty' <<<"$json")"
  busy="$(jq -r '.busy // false' <<<"$json")"
  [[ "$busy" != true ]] || { print -u2 "Runner is busy. Use drain so the active job is not interrupted."; exit 75; }
  [[ -n "$id" ]] && withdraw_labels "$id"
  stop_service
  stop_awake
  set_desired_state off
}

reconcile() {
  local desired json busy id free
  desired="$(desired_state)"
  json="$(runner_json)"
  busy="$(jq -r '.busy // false' <<<"$json")"
  id="$(jq -r '.id // empty' <<<"$json")"
  free="$(free_gib)"

  case "$desired" in
    drain)
      [[ -n "$id" ]] && withdraw_labels "$id"
      if [[ "$busy" != true ]]; then stop_service; stop_awake; set_desired_state off; fi
      ;;
    available)
      if (( free < MIN_FREE_GIB )); then
        [[ -n "$id" ]] && withdraw_labels "$id"
        if [[ "$busy" == true ]]; then set_desired_state drain
        else stop_service; stop_awake; set_desired_state off
        fi
      else
        # Above the floor the advertised set should match the configuration, so
        # a config edit converges on its own instead of waiting for `available`.
        [[ -n "$id" ]] && converge_labels "$id" "$json"
        # Desired Available means a running listener. Without this, a service
        # stopped behind the controller's back — a crash, a racing command —
        # leaves the Mac advertising labels with nothing to take the jobs.
        if [[ -n "$id" && -x "$RUNNER_DIR/svc.sh" ]]; then start_awake; start_service; fi
        if [[ "$busy" != true ]] && (( free < SOFT_FREE_GIB )) && sweep_due; then
          # Idle and heading toward the floor: reclaim now so a future job is not
          # denied at admission time. Never denies, never touches eligibility.
          run_disk_guard sweep || true
          : > "$SWEEP_STAMP"
        fi
      fi
      ;;
    off)
      if [[ "$busy" != true ]]; then
        [[ -n "$id" ]] && withdraw_labels "$id"
        stop_service; stop_awake
      fi
      ;;
    *) print -u2 "Invalid desired state: $desired"; exit 65 ;;
  esac
}

# The runner hands ACTIONS_RUNNER_HOOK_JOB_STARTED to bash without quoting it, so
# a hook path containing a space is split and the job fails in "Set up runner"
# before its first step. Every default install has one: "Application Support".
# The hook is therefore reached through a link inside the runner directory,
# whose path this project controls and checks.
HOOK_LINK="$RUNNER_DIR/mac-ci-burst-job-started.sh"

install_hook() {
  local env_file="$RUNNER_DIR/.env" temporary
  [[ -d "$RUNNER_DIR" ]] || { print -u2 "Runner directory does not exist: $RUNNER_DIR"; exit 78; }
  [[ "$RUNNER_DIR" != *[[:space:]]* ]] || {
    print -u2 "RUNNER_DIR contains whitespace, which the runner cannot pass to its job hook: $RUNNER_DIR"
    exit 78
  }
  [[ -x "$DISK_GUARD" ]] || { print -u2 "Disk guard is not installed: $DISK_GUARD"; exit 78; }
  ln -sfn "$DISK_GUARD" "$HOOK_LINK"
  temporary="$env_file.tmp.$$"
  {
    [[ -f "$env_file" ]] && grep -v '^ACTIONS_RUNNER_HOOK_JOB_STARTED=' "$env_file" || true
    print -r -- "ACTIONS_RUNNER_HOOK_JOB_STARTED=$HOOK_LINK"
  } > "$temporary"
  mv "$temporary" "$env_file"
  # The listener reads .env only at start, so a running service keeps the old path.
  if service_loaded; then
    print -u2 "Runner service is running with the previous hook; apply with: mac-ci-burst off && mac-ci-burst available"
  fi
}

usage() { print -u2 "usage: mac-ci-burst {status|tick|available|drain|off|reconcile|capabilities|install-hook}"; exit 64; }

# The menu's 15-second tick and a command from the CLI are separate processes,
# and each reads the desired state before acting on it after several slow GitHub
# calls. Unserialized, a tick that read "off" can stop the service `available`
# has just started. Mutating commands therefore hold one lock for their whole run.
acquire_lock() {
  local lock="$APP_SUPPORT/.lock" rc=0
  zmodload zsh/system
  # flock opens the file but will not create it.
  : >> "$lock"
  zsystem flock -t "${MAC_CI_BURST_LOCK_TIMEOUT:-120}" "$lock" || rc=$?
  (( rc == 0 )) && return
  # Status 2 is the timeout; anything else is a failure to take the lock at all,
  # which must not be reported as contention.
  if (( rc == 2 )); then
    print -u2 "Another mac-ci-burst command is still running; try again shortly"
    exit 75
  fi
  print -u2 "Could not lock $lock"
  exit 74
}

require_tools
case "${1:-}" in
  tick|available|drain|off|reconcile|install-hook) acquire_lock ;;
esac
case "${1:-}" in
  status) status_json ;;
  tick) reconcile; status_json ;;
  available) make_available ;;
  drain) begin_drain ;;
  off) turn_off ;;
  reconcile) reconcile ;;
  install-hook) install_hook ;;
  *) usage ;;
esac
